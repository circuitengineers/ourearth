# Public (safe to expose to the browser) — used by the client-side Supabase client
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — NEVER prefix these with NEXT_PUBLIC_, and never commit real values.
# Used only inside app/api/admin/**/route.js.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=you@yourdomain.org
BREVO_SENDER_NAME=OurEarth

# A password for the /admin review queue. Make this long and random —
# anyone with this value can approve, reject, and send stories.
ADMIN_API_SECRET=choose-a-long-random-string
